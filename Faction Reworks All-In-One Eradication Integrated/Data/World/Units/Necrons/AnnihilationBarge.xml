<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>
		<unit mesh="Units/Necrons/AnnihilationBarge"
				material="Units/Necrons/AnnihilationBarge"
				idleAnimation="Units/Necrons/AnnihilationBargeIdle"
				idleAnimationCount="3"
				idleContinuously="1"
				scale="0.9 0.9 0.9"
				explosionsBone="BloodBone"/>
	</model>
	<weapons>
		<weapon name="GaussCannon">
			<model>
				<beamWeapon muzzleBone=".PlasmaMuzzle"
						fireInterval="0.666666666667"/>
			
			</model>
		</weapon>
		<weapon name="TwinLinkedTeslaDestructor">
			<model>
				<beamWeapon muzzleBone=".Muzzle"
						muzzleCount="2"/>
			</model>
		</weapon>
	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="7"/> <!-- %armor base armor=11/11/11 -->

				<oreCost base="60.0"/> <!-- %energyCost base tier=7 factor=1 -->
				<hitpointsMax base="24.0"/> <!-- %hitpointsMax base armor=11/11/11 wounds=3 -->
				<moraleMax base="12"/> <!-- %moraleMax base leadership=10 -->
				<movementMax base="4"/>

				<oreUpkeep base="3"/> <!-- %oreUpkeep base tier=7 factor=1 -->
				<productionCost base="42.0"/> <!-- %productionCost base tier=7 factor=1 -->
				<rangedAccuracy base="8"/> <!-- %rangedAccuracy base ballisticSkill=4 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseVehiclesScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action	animation="Units/Necrons/AnnihilationBargeAttack"
						beginFire="0.666666666667"
						endFire="2.3"/>
			</model>		
		</attack>
		<die>
			<model>
				<action animation="Units/Necrons/AnnihilationBargeDie"
						sound="Units/MediumVehicleDie"
						soundCount="3"
						soundDelay="0.3"/>
			</model>		
		</die>
		<idle>
			<model>
				<action animationSpeed="1.0"/>
			</model>
		</idle>
		<move>
			<model>
				<action animation="Units/Necrons/AnnihilationBargeMove"
						sound="Units/Necrons/AnnihilationBargeMove"
						soundCount="3"/>
			</model>
		</move>
		<necrodermisRepair 
				consumedActionPoints="1" consumedMovement="0"
				cooldown="5"
				name="Necrons/NecrodermisRepair"
				requiredActionPoints="1">
			<model>
				<action sound="Actions/Heal"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="20"/>
					</effects>
				</modifier>
	
				<modifier requiredUpgrade="Necrons/NecrodermisRepair2">
					<effects>
						<consumedActionPoints max="0"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/NecrodermisRepair4">
					<effects>
						<cooldown add="-2"/>
					</effects>
				</modifier>
			</modifiers>
			<conditions>
				<unit>
					<damaged/>
				</unit>
			</conditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
											<hitpointsFactorFromMax add="0.25"/>
									</effects>
								</modifier>
								<modifier requiredUpgrade="Necrons/NecrodermisRepair3">
									<effects>
										<hitpointsFactorFromMax add="0.15"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</necrodermisRepair>


		<jink consumedActionPoints="0" consumedMovement="0" requiredActionPoints="0" cooldown="3">
			<model>
				<action sound="Actions/ChargeUp"/>
			</model>
			<conditions>
				<unit>
					<notAttackedThisTurn/>
				</unit>
			</conditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<addTrait duration="1" name="Jink"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</jink>
		<quantumShielding cooldown="2"
				name="Necrons/QuantumShielding"
				passive="1"
				requiredUpgrade="Necrons/QuantumShielding">
			<perTurnProcessUseConditions>
				<unit>
					<damagedThisTurn/>
				</unit>
			</perTurnProcessUseConditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<addTrait name="Necrons/QuantumShielding"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</quantumShielding>
	</actions>
	<traits>



		<trait name="Necrons/VehicleDefensivUpgrade" requiredUpgrade="Necrons/VehicleDefensivUpgrade"/>
		<trait name="Necrons/VehicleOffensivUpgrade" requiredUpgrade="Necrons/VehicleOffensivUpgrade"/>

		<trait name="Necrons/VehicleDefensivUpgrade2" requiredUpgrade="Necrons/AdvancedDefensivUpgrade"/>
		<trait name="Necrons/VehicleOffensivUpgrade2" requiredUpgrade="Necrons/AdvancedOffensivUpgrade"/>



		<trait name="Necrons/AttackCityBonus" requiredUpgrade="Necrons/AttackCityBonus"/>

		<trait name="Necrons/LivingMetal"/>
		<trait name="OpenTopped"/>
		<trait name="Skimmer"/>
		<trait name="Vehicle"/>
	</traits>
</unit>
