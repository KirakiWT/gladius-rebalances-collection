<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>
		<unit mesh="Units/Necrons/Lord"
				material="Units/Necrons/Lord"
				idleAnimation="Units/Necrons/LordIdle"
				idleAnimationCount="3"
				idleContinuously="1"
				normalWeight="0.1"
				scale="1.2 1.2 1.2"
				explosionsBone="BloodBone"
				walker="1"/>
	</model>
	<weapons>
		<weapon name="StaffOfLight">
			<model>
				<beamWeapon mesh="Weapons/Necrons/LordStaffOfLight"
						material="Units/Necrons/Lord"
						muzzleBone=".Muzzle"
						bone="Bone074(mirrored)002"
						fireInterval="0.2"/>
			</model>
		</weapon>
		<weapon name="Voidblade" slotName="Voidblade">
			<model>
				<weapon mesh="Weapons/Necrons/Voidblade"
						material="Units/Necrons/Lord"
						bone="Bone074(mirrored)(mirrored)"
						fireInterval="0.5"/>
			</model>
		</weapon>
	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="8"/> <!-- %armor base armor=3+ -->
				<energyCost base="40.0"/> <!-- %energyCost base tier=6 factor=1 -->
				<hitpointsMax base="22.0"/> <!-- %hitpointsMax base toughness=5 wounds=3 -->
				<influenceCost base="80.0"/> <!-- %influenceCost base tier=6 factor=2 -->
				<itemSlots base="6"/>
				<levelMax base="9"/>
				<meleeAccuracy base="8"/> <!-- %meleeAccuracy base weaponSkill=4 -->
				<meleeAttacks base="3"/>
				<strengthDamage base="2"/> <!-- %strengthDamage base strength=5 -->
				<!-- <meleeInitiative base="2"/> -->
				<moraleMax base="12"/> <!-- %moraleMax base leadership=10 -->
				<movementMax base="3"/>
				<energyUpkeep base="2.0"/> <!-- %oreUpkeep base tier=6 factor=1 -->
				<productionCost base="36.0"/> <!-- %productionCost base tier=6 factor=1 -->
				<rangedAccuracy base="8"/> <!-- %rangedAccuracy base ballisticSkill=4 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseHeroesScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action	animation="Units/Necrons/LordAttack"
						beginFire="0.6"
						endFire="2.0"
						chargeAnimation="Units/Necrons/LordCharge"
						chargeBeginFire="0.5"
						chargeEndFire="1.5"
						meleeAnimation="Units/Necrons/LordMelee"
						meleeBeginSwing="0.2"
						meleeEndSwing="0.9"/>
			</model>
		</attack>
		<die>
			<model>
				<action animation="Units/Necrons/LordDie"
						animationCount="1"
						sound="Units/MediumArmoredDie"
						soundCount="4"
						soundDelay="1.7"
						voiceSound="Units/Necrons/Die"
						voiceSoundCount="7"/>
			</model>		
		</die>
		<idle>
			<model>
				<action animationSpeed="1.0"/>
			</model>
		</idle>
		<move>
			<model>
				<action animation="Units/Necrons/LordMove"
						sound="Units/Necrons/InfantryMove"
						soundCount="4"/>
			</model>
		</move>

		<necrodermisRepair 
				consumedActionPoints="1" consumedMovement="0"
				cooldown="5"
				name="Necrons/NecrodermisRepair"
				requiredActionPoints="1">
			<model>
				<action sound="Actions/Heal"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="15"/>
					</effects>
				</modifier>
	
				<modifier requiredUpgrade="Necrons/NecrodermisRepair2">
					<effects>
						<consumedActionPoints max="0"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/NecrodermisRepair4">
					<effects>
						<cooldown add="-2"/>
					</effects>
				</modifier>
			</modifiers>
			<conditions>
				<unit>
					<damaged/>
				</unit>
			</conditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
											<hitpointsFactorFromMax add="0.25"/>
									</effects>
								</modifier>
								<modifier requiredUpgrade="Necrons/NecrodermisRepair3">
									<effects>
											<hitpointsFactorFromMax add="0.15"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</necrodermisRepair>



		<dimensionalCorridor cooldown="3"
				name="Necrons/DimensionalCorridor"
				requiredUpgrade="Necrons/DimensionalCorridor">
			<model>
				<action sound="Actions/Teleport"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="20"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/DimensionalCorridor3">
					<effects>
						<consumedActionPoints max="0"/>
						<consumedMovement max="0"/>
					</effects>
				</modifier>
			</modifiers>
		</dimensionalCorridor>
		<voidStrike cooldown="3"
				name="Necrons/VoidStrike"
				rank="-1"
				rankMax="2"
				weaponSlotName="Voidblade">
			<model>
				<action meleeAnimation="Units/Necrons/LordMelee"/>
			</model>
			<modifiers>
				<modifier>
					<effects>
						<attacks addMin="4" addMax="12"/>
					</effects>
				</modifier>
			</modifiers>
		</voidStrike>



		<crucibleOfMalediction 
		cooldownMin="5"
		cooldownMax="3"
				name="Necrons/StaffofSearingLight"
				rank="-1"
				rankMax="2">
			<model>
		<action	animation="Units/Necrons/LordAttack"
						beginFire="0.6"
						endFire="2.0"/>
			</model>
			<modifiers>
				<modifier>
					<effects>
						<damage mulMin="0.0" mulMax="1.0"/>
					</effects>
				</modifier>
			</modifiers>
			<beginTargets>
				<target rangeMax="2" lineOfSight="1">
					<conditions>
						<unit>
							<enemy/>
						</unit>
					</conditions>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<weaponDamage weapon="StaffOfLight"/>
										<addTrait duration="1" name="Necrons/Crippled"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</target>
			</beginTargets>
		</crucibleOfMalediction>





<genericUnitAbility name="Necrons/TheArtOfWar"
				passive="1" 
				rank="-1" 
				rankMax="2">
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Tile" radius="2">
							<modifiers>
								<modifier>
									<effects>
										<addTrait name="Necrons/TheArtOfWar"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</genericUnitAbility>		




		<royalGuard cooldown="5"
				elite="1"
				levelUpPriority="1"
				name="Necrons/RoyalGuard"
				rank="-1"
				rankMax="0"> <!-- growing billboarded particle growing from his chest -->
			<model>
				<action animation="Units/Necrons/LordAbility"
						sound="Actions/PsychicBuff"/>
			</model>
			<beginTargets>
				<target rangeMax="1">
					<conditions>
						<tile>
							<land/>
							<noUnit/>
							<noFeature name="GravityWaves"/>
						</tile>
					</conditions>
					<areas>
						<area affects="Tile">
							<modifiers>
								<modifier>
									<effects>
										<addUnit name="Necrons/TriarchPraetorian" consumedAction="0" consumedMovement="0"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<addTrait duration="3" name="Summon"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</target>
			</beginTargets>
		</royalGuard>
		<levelUp/>
		<shop/>
	</actions>
	<traits>


		<trait name="Necrons/InfantryDefensivUpgrade" requiredUpgrade="Necrons/InfantryDefensivUpgrade"/>
		<trait name="Necrons/InfantryOffensivUpgrade" requiredUpgrade="Necrons/InfantryOffensivUpgrade"/>

		<trait name="Necrons/InfantryDefensivUpgrade2" requiredUpgrade="Necrons/AdvancedDefensivUpgrade"/>
		<trait name="Necrons/InfantryOffensivUpgrade2" requiredUpgrade="Necrons/AdvancedOffensivUpgrade"/>


		<trait name="Necrons/AttackCityBonus" requiredUpgrade="Necrons/AttackCityBonus"/>
	
		<trait name="Hero1"/>
		<trait name="Necrons/ReanimationProtocols"/>
		<trait name="Necrons/HeroReanimationBonus"/>
	</traits>
</unit>
