<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>
		<unit mesh="Units/Necrons/HeavyDestroyer"
				material="Units/Necrons/HeavyDestroyer"
				idleAnimation="Units/Necrons/HeavyDestroyerIdle"
				idleAnimationCount="3"
				idleContinuously="1"
				normalWeight="0.1"
				scale="0.8 0.8 0.8"
				explosionsBone="BloodBone"
				walker="1"/>
	</model>
	<group size="2" rowSize="2" memberDeltaX="64" memberDeltaY="80"/>
	<weapons>
		<weapon name="HeavyGaussCannon">
			<model>
				<beamWeapon muzzleBone=".Muzzle0"
						fireInterval="0.833333333333"/>
			</model>
		</weapon>
	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="8"/> <!-- %armor base armor=3+ -->
				<energyCost base="60.0"/> <!-- %energyCost base tier=6 factor=1 -->
				<hitpointsMax base="10.0"/> <!-- %hitpointsMax base toughness=5 wounds=2 -->
				<meleeAccuracy base="8"/> <!-- %meleeAccuracy base weaponSkill=4 -->
				<meleeAttacks base="1"/>
				<strengthDamage base="1.5"/> <!-- %strengthDamage base strength=4 -->
				<!-- <meleeInitiative base="2"/> -->
				<moraleMax base="12"/> <!-- %moraleMax base leadership=10 -->
				<movementMax base="3"/>
				<energyUpkeep base="3.0"/> <!-- %oreUpkeep base tier=6 factor=1 -->
				<productionCost base="42.0"/> <!-- %productionCost base tier=6 factor=1 -->
				<rangedAccuracy base="10"/> <!-- %rangedAccuracy base ballisticSkill=4 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseInfantryScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action	animation="Units/Necrons/HeavyDestroyerAttack"
						beginFire="1.25"
						endFire="2.5"/>
			</model>
		</attack>
		<die>
			<model>
				<action animation="Units/Necrons/HeavyDestroyerDie"
						animationCount="2"
						sound="Units/MediumArmoredDie"
						soundCount="4"
						soundDelay="1.0"
						voiceSound="Units/Necrons/Die"
						voiceSoundCount="7"/>
			</model>		
		</die>
		<idle>
			<model>
				<action animationSpeed="1.0"/>
			</model>
		</idle>
		<move>
			<model>
				<action animation="Units/Necrons/HeavyDestroyerMove"
						sound="Units/Necrons/DestroyerMove"
						soundCount="3"/>
			</model>
		</move>
		<necrodermisRepair 
				consumedActionPoints="1" consumedMovement="0"
				cooldown="5"
				name="Necrons/NecrodermisRepair"
				requiredActionPoints="1">
			<model>
				<action sound="Actions/Heal"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="20"/>
					</effects>
				</modifier>
	
				<modifier requiredUpgrade="Necrons/NecrodermisRepair2">
					<effects>
						<consumedActionPoints max="0"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/NecrodermisRepair4">
					<effects>
						<cooldown add="-2"/>
					</effects>
				</modifier>
			</modifiers>
			<conditions>
				<unit>
					<damaged/>
				</unit>
			</conditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
											<hitpointsFactorFromMax add="0.25"/>
									</effects>
								</modifier>
								<modifier requiredUpgrade="Necrons/NecrodermisRepair3">
									<effects>
										<hitpointsFactorFromMax add="0.15"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</necrodermisRepair>



		<dimensionalCorridor cooldown="3"
				name="Necrons/DimensionalCorridor"
				requiredUpgrade="Necrons/DimensionalCorridor">
			<model>
				<action sound="Actions/Teleport"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="20"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/DimensionalCorridor3">
					<effects>
						<consumedActionPoints max="0"/>
						<consumedMovement max="0"/>
					</effects>
				</modifier>
			</modifiers>
		</dimensionalCorridor>
	</actions>
	<traits>



		<trait name="Necrons/InfantryDefensivUpgrade" requiredUpgrade="Necrons/InfantryDefensivUpgrade"/>
		<trait name="Necrons/InfantryOffensivUpgrade" requiredUpgrade="Necrons/InfantryOffensivUpgrade"/>

		<trait name="Necrons/InfantryDefensivUpgrade2" requiredUpgrade="Necrons/AdvancedDefensivUpgrade"/>
		<trait name="Necrons/InfantryOffensivUpgrade2" requiredUpgrade="Necrons/AdvancedOffensivUpgrade"/>


		<trait name="Bulky"/>
		<trait name="Necrons/AttackCityBonus" requiredUpgrade="Necrons/AttackCityBonus"/>

		<trait name="JetPack"/>
		
		<trait name="Relentless"/>
		<trait name="Necrons/ReanimationProtocols"/>
	</traits>
</unit>
