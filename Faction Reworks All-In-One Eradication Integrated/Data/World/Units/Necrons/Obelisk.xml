<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>
		<unit mesh="Units/Necrons/Obelisk"
				material="Units/Necrons/Obelisk"
				idleAnimation="Units/Necrons/ObeliskIdle"
				idleAnimationCount="1"
				idleContinuously="1"
				scale="1 1 1"
				explosionsBone="Hull"/>
	</model>
	<weapons>
		<weapon name="TeslaSphere" count="4">
			<model>
				<beamWeapon muzzleBone=".Muzzle"
						muzzleCount="3"
						fireInterval="0.2"/>			
			</model>
		</weapon>
	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="10"/> <!-- %armor base armor=14/14/14 -->
				<oreCost base="80.0"/> <!-- %energyCost base tier=11 factor=1 -->
				<energyCost base="80.0"/> <!-- %energyCost base tier=11 factor=1 -->

				<hitpointsMax base="64.0"/> <!-- %hitpointsMax base armor=14/14/14 wounds=6 -->
				<moraleMax base="12"/> <!-- %moraleMax base leadership=10 -->
				<movementMax base="3"/>
				<energyUpkeep base="4.0"/> <!-- %oreUpkeep base tier=11 factor=1 -->
				<oreUpkeep base="4.0"/> <!-- %oreUpkeep base tier=11 factor=1 -->
				<productionCost base="60.0"/> <!-- %productionCost base tier=11 factor=1 -->
				<rangedAccuracy base="8"/> <!-- %rangedAccuracy base ballisticSkill=4 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseVehiclesScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action	animation="Units/Necrons/ObeliskAttack"
						beginFire="0.25"
						endFire="3.0"/>
			</model>		
		</attack>
		<die>
			<model>
				<action animation="Units/Necrons/ObeliskDie"
						sound="Units/LargeVehicleDie"
						soundCount="3"
						soundDelay="0.3"/>
			</model>		
		</die>
		<idle>
			<model>
				<action animationSpeed="1.0"/>
			</model>
		</idle>
		<move>
			<model>
				<action sound="Units/Necrons/ObeliskMove"
						soundCount="2"/>
			</model>
		</move>
		<auraOfFear passive="1">
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Tile" excludeRadius="0" radius="1">
							<modifiers>
								<modifier>
									<effects>
										<addTrait name="Fear"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</auraOfFear>

		<necrodermisRepair 
				consumedActionPoints="1" consumedMovement="0"
				cooldown="5"
				name="Necrons/NecrodermisRepair"
				requiredActionPoints="1">
			<model>
				<action sound="Actions/Heal"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="120"/>
					</effects>
				</modifier>
	
				<modifier requiredUpgrade="Necrons/NecrodermisRepair2">
					<effects>
						<consumedActionPoints max="0"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/NecrodermisRepair4">
					<effects>
						<cooldown add="-2"/>
					</effects>
				</modifier>
			</modifiers>
			<conditions>
				<unit>
					<damaged/>
				</unit>
			</conditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
											<hitpointsFactorFromMax add="0.25"/>
									</effects>
								</modifier>
								<modifier requiredUpgrade="Necrons/NecrodermisRepair3">
									<effects>
											<hitpointsFactorFromMax add="0.15"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</necrodermisRepair>


		<genericUnitAbility name="Necrons/GravityPulse"
				passive="1">
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Tile" radius="3" excludeRadius="0">
							<modifiers>
								<modifier>
									<effects>
										<addTrait name="Necrons/GravityPulse"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</genericUnitAbility>
		<genericUnitAbility name="Necrons/SleepingSentry"
				passive="1"
				enabled="0"
				disableable="1">
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<addTrait name="Necrons/SleepingSentry"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</genericUnitAbility>
	</actions>
	<traits>

		<trait name="Necrons/AdvancedDefensivUpgrade" requiredUpgrade="Necrons/AdvancedDefensivUpgrade"/>
		<trait name="Necrons/AdvancedOffensivUpgrade" requiredUpgrade="Necrons/AdvancedOffensivUpgrade"/>


		<trait name="Necrons/AttackCityBonus" requiredUpgrade="Necrons/AttackCityBonus"/>

		<trait name="MoveThroughCover"/>
		<trait name="Necrons/LivingMetal"/>
		<trait name="Skimmer"/>
		<trait name="SuperHeavy"/>
		<trait name="Vehicle"/>
	</traits>
</unit>
