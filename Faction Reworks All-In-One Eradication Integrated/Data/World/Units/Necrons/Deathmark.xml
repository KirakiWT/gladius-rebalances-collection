<?xml version="1.0" encoding="utf-8"?>
<unit dlc="Supplement12">
	<model>
		<unit mesh="Units/Necrons/Deathmark"
				material="Units/Necrons/Deathmark"
				idleAnimation="Units/Necrons/DeathmarkIdle"
				idleAnimationCount="3"
				idleContinuously="1"
				normalWeight="0.1"
				scale="1.0 1.0 1.0"
				explosionsBone="Chest"
				walker="1"/>
	</model>
	<group size="5" rowSize="3" memberDeltaX="64" memberDeltaY="64"/>
	<weapons>
		<weapon name="SynapticDisintegrator">
			<model>
				<beamWeapon muzzleBone="Muzzle"/>
			</model>
		</weapon>
	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="6"/> <!-- %armor base armor=3+ -->
				<energyCost base="40.0"/> <!-- %energyCost base tier=6 factor=1 -->
				<hitpointsMax base="3.0"/> <!-- %hitpointsMax base toughness=4 wounds=1 -->
				<meleeAccuracy base="8"/> <!-- %meleeAccuracy base weaponSkill=4 -->
				<meleeAttacks base="1"/>
				<strengthDamage base="1.5"/> <!-- %strengthDamage base strength=4 -->
				<!-- <meleeInitiative base="2"/> -->
				<moraleMax base="10"/> <!-- %moraleMax base leadership=10 -->
				<movementMax base="3"/>
				<energyUpkeep base="2.0"/> <!-- %oreUpkeep base tier=6 factor=1 -->
				<productionCost base="36.0"/> <!-- %productionCost base tier=6 factor=1 -->
				<rangedAccuracy base="8"/> <!-- %rangedAccuracy base ballisticSkill=4 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseInfantryScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action	animation="Units/Necrons/DeathmarkAttack"
						beginFire="1.4"
						endFire="1.5"/>
			</model>
		</attack>
		<die>
			<model>
				<action animation="Units/Necrons/DeathmarkDie"
						animationCount="2"
						sound="Units/MediumArmoredDie"
						soundCount="4"
						soundDelay="0.55"
						voiceSound="Units/Necrons/Die"
						voiceSoundCount="7"/>
			</model>		
		</die>
		<idle>
			<model>
				<action animationSpeed="1.0"/>
			</model>
		</idle>
		<move>
			<model>
				<action animation="Units/Necrons/DeathmarkMove"
						sound="Units/Necrons/InfantryMove"
						soundCount="4"/>
			</model>
		</move>

		<necrodermisRepair 
				consumedActionPoints="1" consumedMovement="0"
				cooldown="5"
				name="Necrons/NecrodermisRepair"
				requiredActionPoints="1">
			<model>
				<action sound="Actions/Heal"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="15"/>
					</effects>
				</modifier>
	
				<modifier requiredUpgrade="Necrons/NecrodermisRepair2">
					<effects>
						<consumedActionPoints max="0"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/NecrodermisRepair4">
					<effects>
						<cooldown add="-2"/>
					</effects>
				</modifier>
			</modifiers>
			<conditions>
				<unit>
					<damaged/>
				</unit>
			</conditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
											<hitpointsFactorFromMax add="0.25"/>
									</effects>
								</modifier>
								<modifier requiredUpgrade="Necrons/NecrodermisRepair3">
									<effects>
											<hitpointsFactorFromMax add="0.15"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</necrodermisRepair>



		<dimensionalCorridor cooldown="3"
				name="Necrons/DimensionalCorridor"
				requiredUpgrade="Necrons/DimensionalCorridor">
			<model>
				<action sound="Actions/Teleport"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="20"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/DimensionalCorridor3">
					<effects>
						<consumedActionPoints max="0"/>
						<consumedMovement max="0"/>
					</effects>
				</modifier>
			</modifiers>
		</dimensionalCorridor>
		<huntersFromHyperspace cooldown="10"
				consumedActionPoints="0"
				name="Necrons/HuntersFromHyperspace"
				requiredActionPoints="0">
			<model>
				<action sound="Actions/HuntersFromHyperspace"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="20"/>
					</effects>
				</modifier>
			</modifiers>
			<endTargets>
				<target>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<addTrait duration="1" name="Necrons/HuntersFromHyperspace"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</target>
			</endTargets>
		</huntersFromHyperspace>

		<scout consumedActionPoints="0" consumedMovement="0"
				cooldown="3"
				requiredActionPoints="0">
			<model>
				<action sound="Actions/Scan"/>
			</model>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Tile" radius="4">
							<modifiers>
								<modifier>
									<effects>
										<reveal/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</scout>







	</actions>
	<traits>

		<trait name="Necrons/InfantryDefensivUpgrade" requiredUpgrade="Necrons/InfantryDefensivUpgrade"/>
		<trait name="Necrons/InfantryOffensivUpgrade" requiredUpgrade="Necrons/InfantryOffensivUpgrade"/>

		<trait name="Necrons/InfantryDefensivUpgrade2" requiredUpgrade="Necrons/AdvancedDefensivUpgrade"/>
		<trait name="Necrons/InfantryOffensivUpgrade2" requiredUpgrade="Necrons/AdvancedOffensivUpgrade"/>


		<trait name="Necrons/AttackCityBonus" requiredUpgrade="Necrons/AttackCityBonus"/>

		<trait name="Necrons/ReanimationProtocols"/>
	</traits>
</unit>
