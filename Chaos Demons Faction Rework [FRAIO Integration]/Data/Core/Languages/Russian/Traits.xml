	<entry name="ChaosDaemons_MT/HammerOfWrath/NurgleDescription" value="Увеличивает урон от оружия, не являющегося бомбой."/>
	<entry name="ChaosDaemons_MT/HammerOfWrath/NurgleFlavor" value="<string name='Actions/HammerOfWrathFlavor'/>"/>
	<entry name="ChaosDaemons_MT/HammerOfWrath/Tzeentch" value="<string name='Actions/HammerOfWrath'/>"/>
	<entry name="ChaosDaemons_MT/HammerOfWrath/TzeentchDescription" value="Увеличивает урон от оружия, не являющегося бомбой. Уменьшает урон противника, не связанный с бомбами."/>
	<entry name="ChaosDaemons_MT/HammerOfWrath/TzeentchFlavor" value="<string name='Actions/HammerOfWrathFlavor'/>"/>
	<entry name="ChaosDaemons_MT/HammerOfWrath/Slaanesh" value="<string name='Actions/HammerOfWrath'/>"/>
	<entry name="ChaosDaemons_MT/HammerOfWrath/SlaaneshDescription" value="Увеличивает урон и бронепробиваемость оружия, не являющегося бомбой."/>
	<entry name="ChaosDaemons_MT/HammerOfWrath/SlaaneshFlavor" value="<string name='Actions/HammerOfWrathFlavor'/>"/>
