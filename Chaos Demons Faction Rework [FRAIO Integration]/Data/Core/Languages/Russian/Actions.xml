	<entry name="ChaosDaemons_MT/LocusOfUnstoppableFuryDescription" value="Оружие ближнего боя отрядов Кхорна поражает дополнительные цели."/>
	<entry name="ChaosDaemons_MT/LocusOfUnstoppableFuryFlavor" value="<string name='Traits/ChaosDaemons_MT/Locus/LocusOfUnstoppableFuryFlavor'/>"/>
