	<entry name="ChaosDaemons_MT/ReinforcedHullsFlavor" value="Plates scavenged from a thousand wars, welded together with blood."/>
	<entry name="ChaosDaemons_MT/KhorneAscension2" value="Avatar of Slaughter"/>
