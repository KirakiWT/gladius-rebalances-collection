	<entry name="ChaosDaemons_MT/Belakor/Dead" value="The first Prince of Chaos"/>
	<entry name="ChaosDaemons_MT/Belakor/DeadDescription" value="Reduce your units damage and increase the damage they take upon Be'lakors demise."/>
	<entry name="ChaosDaemons_MT/Belakor/DeadFlavor" value="<string name='Units/ChaosDaemons_MT/BelakorFlavor'/>"/>

	<entry name="ChaosDaemons_MT/Belakor/Death" value="The first Prince of Chaos"/>
	<entry name="ChaosDaemons_MT/Belakor/DeathDescription" value="Reduce your units damage and increase the damage they take upon Be'lakors demise."/>
	<entry name="ChaosDaemons_MT/Belakor/DeathFlavor" value="<string name='Units/ChaosDaemons_MT/BelakorFlavor'/>"/>

	<entry name="ChaosDaemons_MT/SpellShreddingSymphony" value="Spell-Shredding Symphony"/>
	<entry name="ChaosDaemons_MT/SpellShreddingSymphonyDescription" value="Increase attacks. Increase armor penetration against Psykers."/>
	<entry name="ChaosDaemons_MT/SpellShreddingSymphonyFlavor" value="The vile tunes of torture strummed by these daemon-heralds are so unpalatable that even magic comes undone at their vibrations. So too, as it happens, do the casters."/>



	<entry name="ChaosDaemons_MT/MaestrosOfDiscordance" value="Maestro of Discordance"/>
	<entry name="ChaosDaemons_MT/MaestrosOfDiscordanceDescription" value="Attacks heal allied Chaos Daemon units."/>
	<entry name="ChaosDaemons_MT/MaestrosOfDiscordanceFlavor" value="An Infernal Enrapturess can play music so dissonant that it causes physical harm to enemies while captivating other daemonic entities beyond the veil of reality."/>

	<entry name="ChaosDaemons_MT/EldritchStrength" value="Eldritch Strength"/>
	<entry name="ChaosDaemons_MT/EldritchStrengthDescription" value="Increase attacks."/>
	<entry name="ChaosDaemons_MT/EldritchStrengthFlavor" value="The caster imbues their minions with supernatural might."/>

	<entry name="ChaosDaemons_MT/WeaponCurse" value="Weapon Curse"/>
	<entry name="ChaosDaemons_MT/WeaponCurseDescription" value="Take damage when attacking."/>
	<entry name="ChaosDaemons_MT/WeaponCurseFlavor" value="The Changecaster's strange powers of mutation warp and dull enemy weapons, rendering them near useless."/>

	<entry name="ChaosDaemons_MT/BoltOfTzeentchEnemy" value="Bolt of Tzeentch"/>
	<entry name="ChaosDaemons_MT/BoltOfTzeentchEnemyDescription" value="Reduce damage."/>
	<entry name="ChaosDaemons_MT/BoltOfTzeentchEnemyFlavor" value="<string name='Traits/ChaosDaemons_MT/BoltOfTzeentchFlavor'/>"/>

	<entry name="ChaosDaemons_MT/BoltOfTzeentch" value="Bolt of Tzeentch"/>
	<entry name="ChaosDaemons_MT/BoltOfTzeentchDescription" value="Reduce enemy damage."/>
	<entry name="ChaosDaemons_MT/BoltOfTzeentchFlavor" value="This spell manifests as a prismatic beam of raw magic that tears its victims apart in a display of multispectral colour."/>

	<entry name="ChaosDaemons_MT/InfernalGateway" value="Infernal Gateway"/>
	<entry name="ChaosDaemons_MT/InfernalGatewayDescription" value="Deal damage each turn and limit movement."/>
	<entry name="ChaosDaemons_MT/InfernalGatewayFlavor" value="The daemon opens a portal to the Realm of Chaos, pulling enemies to their doom."/>



	<entry name="ChaosDaemons_MT/SkullsBegetBlood" value="Skulls beget Blood"/>
	<entry name="ChaosDaemons_MT/SkullsBegetBloodDescription" value="Gain lifesteal."/>
	<entry name="ChaosDaemons_MT/SkullsBegetBloodFlavor" value="Torn from the wet and ragged necks of worthy mortal champions, these skulls blaze with balefire as the daemons of Khorne heft and hurl them. They explode amongst the foe to shed more blood for the Blood God."/>

	<entry name="ChaosDaemons_MT/GiftOfDiseaseEnemy" value="Gift of Disease"/>
	<entry name="ChaosDaemons_MT/GiftOfDiseaseEnemyDescription" value="Deal damage each turn."/>
	<entry name="ChaosDaemons_MT/GiftOfDiseaseEnemyFlavor" value="<string name='Traits/ChaosDaemons_MT/GiftOfDiseaseFlavor'/>"/>

	<entry name="ChaosDaemons_MT/GiftOfDisease" value="Gift of Disease"/>
	<entry name="ChaosDaemons_MT/GiftOfDiseaseDescription" value="Restore health each turn. Infect enemies with a diseasse."/>
	<entry name="ChaosDaemons_MT/GiftOfDiseaseFlavor" value="The daemon licks an oozing sore, savouring the tangy flavour of a ripe contagion, before coughing a phlegmy litany that wreathes them and their allies in a pain-inuring ague."/>


	<entry name="ChaosDaemons_MT/RancidVisitations" value="Rancid Visitations"/>
	<entry name="ChaosDaemons_MT/RancidVisitationsDescription" value="Deal damage each turn."/>
	<entry name="ChaosDaemons_MT/RancidVisitationsFlavor" value="Chanting in a phlegm-choked drone, the daemon conjures forth a dense cloud of occluding corpse-gas and biting, blinding flies to engulf the enemy and leave them nauseated and reeling."/>

	<entry name="ChaosDaemons_MT/ArchitectOfDeception" value="Architect of Deception"/>
	<entry name="ChaosDaemons_MT/ArchitectOfDeceptionDescription" value="Decrease accuracy."/>
	<entry name="ChaosDaemons_MT/ArchitectOfDeceptionFlavor" value="No foe, be they mortal or daemonic, can trust their perceptions around this most cunning of daemons. A veil of sorcerous illusion wreathes it so densely that its enemies may not discern the daemon’s true location even should they stand in its very shadow."/>

	<entry name="ChaosDaemons_MT/BloodLegion" value="Blood Legion"/>
	<entry name="ChaosDaemons_MT/BloodLegionDescription" value="Increase attacks."/>
	<entry name="ChaosDaemons_MT/BloodLegionFlavor" value="The daemon legions of Khorne burst into realspace like blood from an artery. Bloodcrushers pound the ground as they lead the charge, slamming into the enemy lines with avalanche force. Behind them come snarling Flesh Hounds and gore-slick Bloodletters, the bellow of brazen war horns sounding their massed charge."/>

	<entry name="ChaosDaemons_MT/ContemptForSorcery" value="Contempt for Sorcery"/>
	<entry name="ChaosDaemons_MT/ContemptForSorceryDescription" value="Increase witchfire damage reduction."/>
	<entry name="ChaosDaemons_MT/ContemptForSorceryFlavor" value="The loathing for witchery that radiates from the daemons of Khorne can unmake even the mightiest of conjurations."/>

	<entry name="ChaosDaemons_MT/DarkGlory" value="Dark Glory"/>
	<entry name="ChaosDaemons_MT/DarkGloryDescription" value="Kill an enemy unit to spread your shadow of chaos."/>
	<entry name="ChaosDaemons_MT/DarkGloryFlavor" value="<string name='Traits/ChaosSpaceMarines/DarkGloryFlavor'/>"/>

	<entry name="ChaosDaemons_MT/DelightfulAgonies" value="Delightful Agonies"/>
	<entry name="ChaosDaemons_MT/DelightfulAgoniesDescription" value="Increase damage reduction and morale regeneration."/>
	<entry name="ChaosDaemons_MT/DelightfulAgoniesFlavor" value="Manipulating the very stuff of its allies’ corporeal manifestations, the daemon turns their physical hurts to euphoric stimuli, allowing them to fight on even with their physical selves in tatters."/>
	
	<entry name="ChaosDaemons_MT/Discipline" value="<string name='Traits/Discipline'/>"/>
	<entry name="ChaosDaemons_MT/DisciplineDescription" value="<string name='Traits/DisciplineDescription'/>"/>
	<entry name="ChaosDaemons_MT/DisciplineFlavor" value="<string name='Traits/DisciplineFlavor'/>"/>

	<entry name="ChaosDaemons_MT/DreadMarshal" value="Dread Marshal"/>
	<entry name="ChaosDaemons_MT/DreadMarshalDescription" value="Increase damage."/>
	<entry name="ChaosDaemons_MT/DreadMarshalFlavor" value="This mighty warrior has proved their devotion to Be’lakor above all, and their loyalty has been rewarded with a host of warriors to command."/>
	
	<entry name="ChaosDaemons_MT/DreadMarshalKhorne" value="<string name='Traits/ChaosDaemons_MT/DreadMarshal'/>"/>
	<entry name="ChaosDaemons_MT/DreadMarshalKhorneDescription" value="Increase damage."/>
	<entry name="ChaosDaemons_MT/DreadMarshalKhorneFlavor" value="<string name='Traits/ChaosDaemons_MT/DreadMarshalFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/DreadMarshalNurgle" value="<string name='Traits/ChaosDaemons_MT/DreadMarshal'/>"/>
	<entry name="ChaosDaemons_MT/DreadMarshalNurgleDescription" value="Increase damage and melee damage reduction."/>
	<entry name="ChaosDaemons_MT/DreadMarshalNurgleFlavor" value="<string name='Traits/ChaosDaemons_MT/DreadMarshalFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/DreadMarshalSlaanesh" value="<string name='Traits/ChaosDaemons_MT/DreadMarshal'/>"/>
	<entry name="ChaosDaemons_MT/DreadMarshalSlaaneshDescription" value="Increase damage and movement."/>
	<entry name="ChaosDaemons_MT/DreadMarshalSlaaneshFlavor" value="<string name='Traits/ChaosDaemons_MT/DreadMarshalFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/DreadMarshalTzeentch" value="<string name='Traits/ChaosDaemons_MT/DreadMarshal'/>"/>
	<entry name="ChaosDaemons_MT/DreadMarshalTzeentchDescription" value="Increase damage and damage reduction."/>
	<entry name="ChaosDaemons_MT/DreadMarshalTzeentchFlavor" value="<string name='Traits/ChaosDaemons_MT/DreadMarshalFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/DreadMarshalUndivided" value="<string name='Traits/ChaosDaemons_MT/DreadMarshal'/>"/>
	<entry name="ChaosDaemons_MT/DreadMarshalUndividedDescription" value="Increase damage and reduce morale loss."/>
	<entry name="ChaosDaemons_MT/DreadMarshalUndividedFlavor" value="<string name='Traits/ChaosDaemons_MT/DreadMarshalFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/FleshyAbundance" value="Fleshy Abundance"/>
	<entry name="ChaosDaemons_MT/FleshyAbundanceDescription" value="Restore health. Increase for servants of Nurgle."/>
	<entry name="ChaosDaemons_MT/FleshyAbundanceFlavor" value="The daemon blesses their allies with Nurgle’s bountiful energies, swelling them into even more grotesquely resilient and corpulent forms."/>
	
	<entry name="ChaosDaemons_MT/GloryOfBattle" value="Glory of Battle"/>
	<entry name="ChaosDaemons_MT/GloryOfBattleDescription" value="Increase attacks and life steal while surrounded by enemies."/>
	<entry name="ChaosDaemons_MT/GloryOfBattleFlavor" value="The more foes that surround this daemon, the faster and more eagerly it fights."/>
	
	<entry name="ChaosDaemons_MT/GreaterDaemon" value="Greater Daemon"/>
	<entry name="ChaosDaemons_MT/GreaterDaemonDescription" value="Increase invulnerable damage reduction."/>
	<entry name="ChaosDaemons_MT/GreaterDaemonFlavor" value="As the greatest daemons slaughter their way across reality, so they grow in power, earning rewards from their patron deity and learning how to shape realspace to augment their forms."/>
	
	<entry name="ChaosDaemons_MT/GrotesqueRegeneration" value="Grotesque Regeneration"/>
	<entry name="ChaosDaemons_MT/GrotesqueRegenerationDescription" value="Increase health regeneration."/>
	<entry name="ChaosDaemons_MT/GrotesqueRegenerationFlavor" value="The daemons of Nurgle are tremendously hard to destroy, all the more so in the presence of this walking font of unclean fecundity. Bountiful waves of diseased vigour roll off the daemon, its grotesque generosity an echo of Nurgles own that mends ruptured corporeal forms, reknits burst innards and thickens leathery flesh with fresh layers of rancid blubber."/>
	
	<entry name="ChaosDaemons_MT/Khorne" value="Servant of Khorne"/>
	<entry name="ChaosDaemons_MT/KhorneDescription" value="Mark of Khorne - +25% attacks and +25% melee damage reduction, but -2 armor (not on vehicles). Allows overwatch attacks with melee weapons. Each kill yields 3 Ore. Upkeep is waived for a unit that attacked this turn and increased by 50% if it ends the turn farther than 2 tiles from every enemy. Allied servants of Tzeentch within 2 tiles cost this unit morale every turn."/>
	<entry name="ChaosDaemons_MT/KhorneFlavor" value="The Blood God instils a blind rage in his most frenzied adherents."/>
	
	<entry name="ChaosDaemons_MT/LegionOfExcess" value="Legion of Excess"/>
	<entry name="ChaosDaemons_MT/LegionOfExcessDescription" value="Increase attacks. Attacks now cause self damage."/>
	<entry name="ChaosDaemons_MT/LegionOfExcessFlavor" value="The legions of Slaanesh surge into battle like a blood-spattered carnival run mad. It is a revel where every swathe of diaphanous silk is braided with screaming souls, and every beautiful smile stretches into a needle-fanged leer of cruellest hunger. The presence of these entities is enough to drive mortals mad as the horrific evidence of their eyes wars with forbidden desire welling inside them like bile."/>
	
	<entry name="ChaosDaemons_MT/Nurgle" value="Servant of Nurgle"/>
	<entry name="ChaosDaemons_MT/NurgleDescription" value="Mark of Nurgle - +25% hitpoints, regeneration and increased healing rate, but -1 movement (not on vehicles). Allied servants of Slaanesh within 2 tiles cost this unit morale every turn."/>
	<entry name="ChaosDaemons_MT/NurgleFlavor" value="The Father of Plagues bestows gifts of rot and decay upon his followers."/>
	
	<entry name="ChaosDaemons_MT/NurglesRot" value="Nurgles Rot"/>
	<entry name="ChaosDaemons_MT/NurglesRotDescription" value="Decrease armor."/>
	<entry name="ChaosDaemons_MT/NurglesRotFlavor" value="Gurgling praise to its god, the daemon exudes a wave of soul-pox that eats away the spiritual essence of those who lack Nurgle’s blessings. Victims’ eyes become glassy, their flesh sinks upon their bones and their limbs fall slack before they collapse and begin to rot before their horrified comrades’ eyes."/>
	
	<entry name="ChaosDaemons_MT/PlagueLegion" value="Plague Legion"/>
	<entry name="ChaosDaemons_MT/PlagueLegionDescription" value="Increase damage reduction."/>
	<entry name="ChaosDaemons_MT/PlagueLegionFlavor" value="One moment, reality is a place of rationality. The next, the veil separating realspace from the Warp strains, then bursts like a fatted boil and from the suppurating rent spill the daemon legions of Nurgle. Despair spreads before them like vomit soaking into pristine silk. Miasmal clouds engulf the foe, causing flesh to blister and slough, metal to fur with rust, and hope itself to rot away into dread misery."/>
	
	<entry name="ChaosDaemons_MT/Possession" value="<string name='Traits/ChaosSpaceMarines/Possession'/>"/>
	<entry name="ChaosDaemons_MT/PossessionDescription" value="Killing enemy units transforms them into allied lesser daemon."/>
	<entry name="ChaosDaemons_MT/PossessionFlavor" value="<string name='Traits/ChaosSpaceMarines/PossessionFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/ScintillatingLegion" value="Scintillating Legion"/>
	<entry name="ChaosDaemons_MT/ScintillatingLegionDescription" value="Reduces ranged damage taken."/>
	<entry name="ChaosDaemons_MT/ScintillatingLegionFlavor" value="Capering and cackling in an endless flux of transmogrifying change, the daemonic legions of Tzeentch unleash kaleidoscopic madness upon their enemies. Malevolent Lords of Change robed in sanity-blasting unhues wield raw magic with the ease of breathing. They marshal their bedlam hordes even as they transform screaming mortals into mounds of mutant flesh or set light to reality itself."/>
	
	<entry name="ChaosDaemons_MT/ScintillatingLegionShield" value="Scintillating Legion: Shield"/>
	<entry name="ChaosDaemons_MT/ScintillatingLegionShieldDescription" value="Grants a shield that activates when attacked."/>
	<entry name="ChaosDaemons_MT/ScintillatingLegionShieldFlavor" value="<string name='Traits/ChaosDaemons_MT/ScintillatingLegionFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/ScreamerBite" value="Screamer Bite"/>
	<entry name="ChaosDaemons_MT/ScreamerBiteDescription" value="Increase armor penetration against monstrous creatures and vehicles."/>
	
	
	
	<entry name="ChaosDaemons_MT/ShrivellingPox" value="Shrivelling Pox"/>
	<entry name="ChaosDaemons_MT/ShrivellingPoxDescription" value="Reduce damage dealt. Take damage each turn."/>
	<entry name="ChaosDaemons_MT/ShrivellingPoxFlavor" value="Muttering an unholy chant in a blighted tongue, the daemon calls down a foul malignancy that races through the enemies’ ranks like wildfire and chews away at their flesh and organs like a tide of ravenous maggots."/>
	
	<entry name="ChaosDaemons_MT/Slaanesh" value="Servant of Slaanesh"/>
	<entry name="ChaosDaemons_MT/SlaaneshDescription" value="Mark of Slaanesh - +1 movement, +50% damage against units with 50% health or less, actions do not consume movement, but -25% hitpoints (not on vehicles). Each kill yields 2 Influence. Allied servants of Nurgle within 2 tiles cost this unit morale every turn."/>
	<entry name="ChaosDaemons_MT/SlaaneshFlavor" value="The thrill of battle drives these warriors to charge at spectacular speed."/>
	
	<entry name="ChaosDaemons_MT/SoulGlutton" value="Soul Glutton"/>
	<entry name="ChaosDaemons_MT/SoulGluttonDescription" value="Restore health when killing an enemy unit."/>
	<entry name="ChaosDaemons_MT/SoulGluttonFlavor" value="This daemon lord guzzles souls, its bloated corporeality reknitting with each fresh morsel."/>
	
	<entry name="ChaosDaemons_MT/SoulGrinderSlaanesh" value="Overwhelming Excess"/>
	<entry name="ChaosDaemons_MT/SoulGrinderSlaaneshDescription" value="Increase range attacks."/>
	<entry name="ChaosDaemons_MT/SoulGrinderSlaaneshFlavor" value="Sensation gushes relentlessly into the overstimulated minds of the enemy until their souls strain fit to burst. Barely able to think or function, they recoil in their desperate need to stem the unstoppable tide."/>
	
	<entry name="ChaosDaemons_MT/Tzeentch" value="Servant of Tzeentch"/>
	<entry name="ChaosDaemons_MT/TzeentchDescription" value="Mark of Tzeentch - +17% damage reduction and attacks inflict Soulblaze (damage over time), but +50% melee damage taken (not on vehicles). Each kill yields 2 Research. Allied servants of Khorne within 2 tiles cost this unit morale every turn."/>
	<entry name="ChaosDaemons_MT/TzeentchFlavor" value="Reality twists and weaves around these warriors as they become intertwined in the machinations of the Change God."/>
	
	<entry name="ChaosDaemons_MT/Undivided" value="Servant of Chaos Undivided"/>
	<entry name="ChaosDaemons_MT/UndividedDescription" value="Classification."/>
	<entry name="ChaosDaemons_MT/UndividedFlavor" value="The Slaves to Darkness forsake their souls by pledging to the Dark Gods."/>
	
	<entry name="ChaosDaemons_MT/WorthyOffering" value="Worthy Offering"/>
	<entry name="ChaosDaemons_MT/WorthyOfferingDescription" value="When gaining experience from combat gain influence."/>
	<entry name="ChaosDaemons_MT/WorthyOfferingFlavor" value="<string name='Traits/ChaosSpaceMarines/WorthyOfferingFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/WrathUndeniable" value="Wrath Undeniable"/>
	<entry name="ChaosDaemons_MT/WrathUndeniableDescription" value="Increase melee damage."/>
	<entry name="ChaosDaemons_MT/WrathUndeniableFlavor" value="Even the banishing blow is often not enough to prevent the daemons of Khorne from lashing out to take bloody vengeance as they discorporate."/>
	
	<entry name="ChaosDaemons_MT/WreathedInShades" value="Wreathed in Shades"/>
	<entry name="ChaosDaemons_MT/WreathedInShadesDescription" value="Increase accuracy and ranged damage reduction."/>
	<entry name="ChaosDaemons_MT/WreathedInShadesFlavor" value="The psyker draws from the warp a churning mass of damned shades, abandoned worshippers of Be’lakor now doomed to conceal and protect his current servants."/>
	
	<entry name="ChaosDaemons_MT/BoonOfChange/BoonOfChange" value="Boon of Change"/>
	<entry name="ChaosDaemons_MT/BoonOfChange/BoonOfChangeDescription" value=""/>
	<entry name="ChaosDaemons_MT/BoonOfChange/BoonOfChangeFlavor" value="As the daemon chants, its minions begin to twist and new forms take shape as the will of Tzeentch demands."/>
	
	<entry name="ChaosDaemons_MT/BoonOfChange/Armor" value="<string name='Traits/ChaosDaemons_MT/BoonOfChange/BoonOfChange'/>"/>
	<entry name="ChaosDaemons_MT/BoonOfChange/ArmorDescription" value="Increase armor."/>
	<entry name="ChaosDaemons_MT/BoonOfChange/ArmorFlavor" value="<string name='Traits/ChaosDaemons_MT/BoonOfChange/BoonOfChangeFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/BoonOfChange/Attacks" value="<string name='Traits/ChaosDaemons_MT/BoonOfChange/BoonOfChange'/>"/>
	<entry name="ChaosDaemons_MT/BoonOfChange/AttacksDescription" value="Increase attacks."/>
	<entry name="ChaosDaemons_MT/BoonOfChange/AttacksFlavor" value="<string name='Traits/ChaosDaemons_MT/BoonOfChange/BoonOfChangeFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/BoonOfChange/Movement" value="<string name='Traits/ChaosDaemons_MT/BoonOfChange/BoonOfChange'/>"/>
	<entry name="ChaosDaemons_MT/BoonOfChange/MovementDescription" value="Increase movement."/>
	<entry name="ChaosDaemons_MT/BoonOfChange/MovementFlavor" value="<string name='Traits/ChaosDaemons_MT/BoonOfChange/BoonOfChangeFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/ShadowLegion/Khorne" value="Shadow Legion"/>
	<entry name="ChaosDaemons_MT/ShadowLegion/KhorneDescription" value="Increase movement."/>
	<entry name="ChaosDaemons_MT/ShadowLegion/KhorneFlavor" value="Heretic Astartes, mortal cultists and nightmarish daemons - all serve Be’lakor and fight amongst the ranks of his Disciples. These fanatical heretics have forsaken the Dark Gods in favour of worshipping their first and greatest champion, whom many of them view as at least a demigod in his own right. "/>
	
	<entry name="ChaosDaemons_MT/ShadowLegion/Nurgle" value="<string name='Traits/ChaosDaemons_MT/ShadowLegion/Khorne'/>"/>
	<entry name="ChaosDaemons_MT/ShadowLegion/NurgleDescription" value="Increase armour."/>
	<entry name="ChaosDaemons_MT/ShadowLegion/NurgleFlavor" value="<string name='Traits/ChaosDaemons_MT/ShadowLegion/KhorneFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/ShadowLegion/Slaanesh" value="<string name='Traits/ChaosDaemons_MT/ShadowLegion/Khorne'/>"/>
	<entry name="ChaosDaemons_MT/ShadowLegion/SlaaneshDescription" value="Ignore enemy overwatch."/>
	<entry name="ChaosDaemons_MT/ShadowLegion/SlaaneshFlavor" value="<string name='Traits/ChaosDaemons_MT/ShadowLegion/KhorneFlavor'/>"/>
	
	<entry name="ChaosDaemons_MT/ShadowLegion/Tzeentch" value="<string name='Traits/ChaosDaemons_MT/ShadowLegion/Khorne'/>"/>
	<entry name="ChaosDaemons_MT/ShadowLegion/TzeentchDescription" value="Increase damage reduction."/>
	<entry name="ChaosDaemons_MT/ShadowLegion/TzeentchFlavor" value="<string name='Traits/ChaosDaemons_MT/ShadowLegion/KhorneFlavor'/>"/>
	
