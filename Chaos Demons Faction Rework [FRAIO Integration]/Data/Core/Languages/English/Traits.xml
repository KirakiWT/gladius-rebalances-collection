	<entry name="ChaosDaemons_MT/ShadowLegion/UndividedDescription" value="Increase melee damage reduction."/>
	<entry name="ChaosDaemons_MT/ShadowLegion/UndividedFlavor" value="<string name='Traits/ChaosDaemons_MT/ShadowLegion/KhorneFlavor'/>"/>
	
