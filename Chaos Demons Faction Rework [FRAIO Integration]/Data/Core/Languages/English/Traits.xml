	<entry name="ChaosDaemons_MT/SlaaneshAscension2" value="Dark Prince’s Apotheosis"/>
	<entry name="ChaosDaemons_MT/SlaaneshAscension2Description" value="+35% hitpoints, +20% damage and +1 movement. Upon researching this technology, all Slaanesh units gain 3 Influence per Experience instead of Influence per Kill Value."/>
	<entry name="ChaosDaemons_MT/SlaaneshAscension2Flavor" value="At the height of its power a greater daemon stands against war engines and titans."/>
