	<entry name="ChaosDaemons_MT/BloodDuelEnemy" value="Blood Duel"/>
	<entry name="ChaosDaemons_MT/BloodDuelEnemyDescription" value="Cannot move more than 1 tile. Deals 30% more damage to Khorne heroes."/>
	<entry name="ChaosDaemons_MT/BloodDuelEnemyFlavor" value="Khorne cares not from whence the blood flows, only that it flows. The Herald calls out a champion, and no foe may refuse."/>
	<entry name="ChaosDaemons_MT/SkullFeast" value="Skull Feast"/>
	<entry name="ChaosDaemons_MT/SkullFeastDescription" value="Gain 2 additional ore for each kill. When this unit kills an enemy with no actions left, it regains 1 action (once every 2 turns)."/>
	<entry name="ChaosDaemons_MT/SkullFeastFlavor" value="Every skull taken fuels the next swing of the blade."/>
	<entry name="ChaosDaemons_MT/SkullFeastRecovery" value="Skull Feast: recovering"/>
	<entry name="ChaosDaemons_MT/SkullFeastRecoveryDescription" value="Cannot regain an action from Skull Feast."/>
	<entry name="ChaosDaemons_MT/SkullFeastRecoveryFlavor" value="Even the Blood God’s favour must be earned anew."/>
