	<entry name="ChaosDaemons_MT/CultistSacrifice/CultistSacrificeDescription" value="Increases the growth rate."/>
	<entry name="ChaosDaemons_MT/CultistSacrifice/CultistSacrificeFlavor" value="<string name='Actions/ChaosSpaceMarines/CultistSacrificeFlavor'/>"/>
	
