	<entry name="ChaosDaemons_MT/BloodDuel" value="Blood Duel"/>
	<entry name="ChaosDaemons_MT/BloodDuelDescription" value="Challenge an enemy within 2 tiles for 2-3 turns. It cannot move more than 1 tile, and it and the Bloodmaster deal 30% more damage to each other."/>
	<entry name="ChaosDaemons_MT/BloodDuelFlavor" value="Khorne cares not from whence the blood flows, only that it flows. The Herald calls out a champion, and no foe may refuse."/>
	<entry name="ChaosDaemons_MT/AltarOfSlaughter" value="Altar of Slaughter"/>
	<entry name="ChaosDaemons_MT/AltarOfSlaughterDescription" value="Creates Khorne Warp Territory on this tile and adjacent tiles for free, replacing Warp Territory belonging to other gods."/>
	<entry name="ChaosDaemons_MT/AltarOfSlaughterFlavor" value="Where the Herald plants his banner the ground drinks deep, and the Blood God’s gaze takes root."/>
	<entry name="ChaosDaemons_MT/PainChorus" value="Pain Chorus"/>
	<entry name="ChaosDaemons_MT/PainChorusDescription" value="Allied units within 2 tiles regain 1-2 morale and gain +1 movement for a turn. Enemies within 1 tile lose 2 morale."/>
	<entry name="ChaosDaemons_MT/PainChorusFlavor" value="The Enrapturess sings, and every ear within reach hears only the sweetest agony."/>
	<entry name="ChaosDaemons_MT/RustFever" value="Rust Fever"/>
	<entry name="ChaosDaemons_MT/RustFeverDescription" value="Curse an enemy within 3 tiles for 3 turns: it loses armour and healing and takes additional damage."/>
	<entry name="ChaosDaemons_MT/RustFeverFlavor" value="One wheeze from the pipes and iron flakes, flesh festers, and even the proudest armour begins to weep orange."/>
