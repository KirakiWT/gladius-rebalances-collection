	<entry name="ChaosDaemons_MT/ChaosLordDescription" value="Hero unit that generates influence and leads the armies of chaos."/>
	<entry name="ChaosDaemons_MT/ChaosLordFlavor" value="<string name='Units/ChaosSpaceMarines/ChaosLordFlavor'/>"/>

