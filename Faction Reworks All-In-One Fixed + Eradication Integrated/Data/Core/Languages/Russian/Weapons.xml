	<entry name="TwinLinkedHeavyFlamerImmolatorFlavor" value="&lt;string name='Weapons/FlamerFlavor'/&gt;"/>
	<entry name="CombiFlamer" value="Комби-огнемёт"/>
	<entry name="CombiFlamerFlavor" value="Болт и пламя объединены праведной целью. Там, где не справляется оружие, очищает огонь."/>
