	<entry name="SplinterRifleArrayFlavor" value="&lt;string name='Weapons/SplinterFlavor'/&gt;"/>
	<entry name="Whiplash" value="Хлыст"/>
	<entry name="WhiplashFlavor" value="&lt;string name='Weapons/AgoniserFlavor'/&gt;"/>
	<entry name="AnimusVitae" value="Анимус Витэ"/>
	<entry name="AnimusVitaeFlavor" value="Анимус Витэ"/>
	<entry name="SkullsquirmBlight" value="Черепная скверна"/>
	<entry name="SkullsquirmBlightFlavor" value="Один из самых любимых даров Дедушки Нургла — микроскопические черви, что пляшут и в костном мозге, и в разуме. Их радостный пир несёт благословенное разложение всем, кто становится свидетелем их божественного голода."/>
	<entry name="MagmaCutter" value="Магмовый резак"/>
	<entry name="MagmaCutterFlavor" value="Питаемые Варпом печи пылают в механическом сердце чудовища, подавая потоки жидкого огня в вычурные оружейные системы. Жажда разрушения демона изливается расплавленной смертью."/>
	<entry name="DaemonClaws" value="Демонические когти"/>
	<entry name="DaemonClawsFlavor" value="Искажённые до полной неузнаваемости когти Отродья сочатся самой сущностью Варпа. Каждый безумный взмах — бессмысленный акт разрушения, разрывающий плоть, броню и даже саму реальность с безумной силой."/>
	<entry name="DarkSorcery" value="Тёмное колдовство"/>
	<entry name="DarkSorceryFlavor" value="Их шепчущие литании оскверняют сам воздух: преданные слуги Хаоса сплетают тёмную магию запретными молитвами своим зловещим богам."/>
	<entry name="GaussFlayerArrayManned" value="Батарея гаусс-расщепителей"/>
	<entry name="GaussFlayerArrayMannedFlavor" value="&lt;string name='Weapons/GaussFlavor'/&gt;"/>
	<entry name="GaussFlayerArrayGhostark" value="Гаусс-расщепители «Призрачного ковчега»"/>
	<entry name="GaussFlayerArrayGhostarkFlavor" value="&lt;string name='Weapons/GaussFlavor'/&gt;"/>
	<entry name="SmallGaussAnnihilator" value="Малый гаусс-аннигилятор"/>
	<entry name="SmallGaussAnnihilatorFlavor" value="Гаусс-пилон черпает энергию из силовой матрицы некронов и направляет её в жёстко встроенные оружейные системы, включая вариант дуги гаусс-потока, установленной также на Монолитах. Куда страшнее гаусс-аннигилятор пилона — узколучевая версия частичного хлыста, которая в сочетании с совершенными системами наведения и захвата целей позволяет поражать как наземные войска, так и приближающуюся авиацию."/>
	<entry name="TeslaDestructor" value="Тесла-деструктор"/>
