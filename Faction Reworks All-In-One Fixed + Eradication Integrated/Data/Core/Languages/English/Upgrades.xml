	<entry name="SpaceMarines/FragGrenadeDescription" value="Grants Tactical Space Marines, Apothecaries, Scouts, Scout Bikers and Devastator Space Marines the ability to throw Frag and Krak granades."/>
	<entry name="SpaceMarines/FragGrenadeFlavor" value="<string name='Weapons/FragGrenadeFlavor'/>"/>

	<entry name="SpaceMarines/MeltaBomb" value="<string name='Weapons/MeltaBomb'/>"/>
