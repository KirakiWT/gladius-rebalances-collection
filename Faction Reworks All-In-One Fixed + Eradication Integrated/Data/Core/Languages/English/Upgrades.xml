	<entry name="SpaceMarines/LastStandDoctrine" value="Advanced Doctrine: Last Stand"/>
	<entry name="SpaceMarines/LastStandDoctrineDescription" value="Advanced Doctrine: Whenever a Space Marine unit is destroyed, all nearby Space Marine units gain +1 Ranged Accuracy, +10% Melee Attacks, and 5% Damage Reduction"/>
	<entry name="SpaceMarines/LastStandDoctrineFlavor" value="Even in death, we serve. Let the blood of our fallen brothers fuel the fires of vengeance, and may their sacrifice echo through the warp itself. For every battle-brother that falls, ten heretics shall follow. This we swear by the Emperor's holy name."/>

	<entry name="SpaceMarines/DozerBlade" value="<string name='Traits/DozerBlade'/>"/>
	<entry name="SpaceMarines/DozerBladeDescription" value="Reduces the movement penalty for Hunters, Predators, Razorbacks and Whirlwinds in forests and imperial ruins. Also grants Siege Shields to Vindicators"/>
	<entry name="SpaceMarines/DozerBladeFlavor" value="<string name='Traits/DozerBladeFlavor'/>"/>

