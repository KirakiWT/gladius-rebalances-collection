	<entry name="AdeptusMechanicus/EnhancedDataTether" value="Enhanced Data-Tether"/>
	<entry name="AdeptusMechanicus/EnhancedDataTetherDescription" value="Grants 2 additional Moral to Skitarii Vanguards, Skitarii Marshall, Skitarii Rangers, Serberys Sulphurhounds, Ruskstalkers, Infiltrators and Sterylizors."/>
	<entry name="AdeptusMechanicus/EnhancedDataTetherFlavor" value="Seen as the mouthpieces of the Tech-Priests, who in turn are the prophets of the Machine God himself, those honoured with bearing enhanced data-tethers are obeyed without hesitation by their reverent Skitarii comrades."/>

	<entry name="AdeptusMechanicus/OrbsOfTheOmnissiah" value="Orbs of the Omnissiah"/>
	<entry name="AdeptusMechanicus/OrbsOfTheOmnissiahDescription" value="Gifted by the Omnissiah, these granades can shutdown any vehicles and fortification useable by Skitarii Vanguard, Skitarii Marshal, Sicarian Infiltrators, Skitarii Rangers, Sulphurhounds, Pteraxii Sterylizors and Electropriest."/>
	<entry name="AdeptusMechanicus/OrbsOfTheOmnissiahFlavor" value="Gifted by the Omnissiah, these granades can shutdown any vehicles and fortification"/>

	<entry name="AdeptusMechanicus/Cinderfang" value="Cinderfang"/>
	<entry name="AdeptusMechanicus/CinderfangDescription" value= "Doctrina Imperatives Devil Dog variant which is equipped with a Melta Cannon and a Heavy Phosphor Blaster."/>
	<entry name="AdeptusMechanicus/CinderfangFlavor" value="Among the forge-temples of Ryza, the name Cinderfang is spoken with reverence and dread. This rare Devil Dog variant replaces chemical weaponry with a brutal Melta Cannon and a hull-mounted Heavy Phosphor Blaster, optimized for total armor liquefaction and blinding suppression."/>

    <entry name="AdeptusMechanicus/CognisHeavyStubber" value="Heavy Stubber and Smokescreen"/>
	<entry name="AdeptusMechanicus/CognisHeavyStubberDescription" value="Grants Onager Dunecrawlers a Cognis Heavy Stubber and Crinderfangs a smoke launcher"/>
	<entry name="AdeptusMechanicus/CognisHeavyStubberFlavor" value="<string name='Weapons/CognisHeavyStubberFlavor'/>"/>

	<entry name="AdeptusMechanicus/VoicesInTheCode" value="<string name='Actions/AdeptusMechanicus/VoicesInTheCode'/>"/>
