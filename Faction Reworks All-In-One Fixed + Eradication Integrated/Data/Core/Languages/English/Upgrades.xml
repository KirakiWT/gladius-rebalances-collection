	<entry name="AstraMilitarum/AstraProd2" value="Heavy Asset Production Edict"/>
	<entry name="AstraMilitarum/AstraProd2Description" value="Increases Production speed of Heavy Armour Complex and Heavy Support Foundry by 20%. except the Headquarters. <br/><br/>Only one Edict can be active at a time."/>
	
	<entry name="AstraMilitarum/AstraRes" value="Resource Extraction Edict"/>
