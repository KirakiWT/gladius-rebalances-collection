<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>
		<unit mesh="Units/SpaceMarines/ThunderfireCannon"
				material="Units/SpaceMarines/ThunderfireCannon"
				idleAnimation="Units/SpaceMarines/ThunderfireCannonIdle"
				idleAnimationCount="3"
				idleContinuously="1"
				normalWeight="0.1"
				scale="0.75 0.75 0.75"
				bloodBone="BloodBone"
				walker="1"/>
	</model>
	<weapons>
		<weapon name="ThunderfireCannon">
			<model>
				<projectileWeapon muzzleBone=".ThunderFire"
						fireInterval="0.1"
						effectScale="1.5"/>
			</model>
		</weapon>

	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="8"/> <!-- %armor base armor=3+ -->
				<energyCost base="30.0"/> <!-- %energyCost base tier=7 factor=0.5 -->
				<hitpointsMax base="12.0"/> <!-- %hitpointsMax base toughness=6 wounds=2 -->
				<meleeAccuracy base="8"/> <!-- %meleeAccuracy base weaponSkill=4 -->
				<meleeAttacks base="2"/>
				<strengthDamage base="1.5"/> <!-- %strengthDamage base strength=4 -->
				<!-- <meleeInitiative base="4"/> -->
				<moraleMax base="10"/> <!-- %moraleMax base leadership=8 -->
				<movementMax base="3"/>
				<productionCost base="42.0"/> <!-- %productionCost base tier=7 factor=1 -->
				<rangedAccuracy base="8"/> <!-- %rangedAccuracy base ballisticSkill=5 -->
				<requisitionsCost base="30.0"/> <!-- %requisitionsCost base tier=7 factor=0.5 -->
				<requisitionsUpkeep base="1.5"/> <!-- %requisitionsUpkeep base tier=7 factor=1 -->
				<energyUpkeep base="1.5"/> <!-- %requisitionsUpkeep base tier=7 factor=1 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseSupportScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action animation="Units/SpaceMarines/ThunderfireCannonAttack"
						beginFire="0.35" endFire="2.5"/>
			</model>				
		</attack>
		<die>
			<model>
				<action animation="Units/SpaceMarines/ThunderfireCannonDie"
						sound="Units/SmallVehicleDie"
						soundCount="3"
						soundDelay="0"
						voiceSound="Units/SpaceMarines/InfantryDie"
						voiceSoundCount="5"/>
			</model>		
		</die>
		<idle>
			<model>
				<action animationSpeed="1.0"/>
			</model>
		</idle>
		<move>
			<model>
				<action animation="Units/SpaceMarines/ThunderfireCannonMove"
						sound="Units/SpaceMarines/ThunderfireCannonMove"
						soundCount="3"/>
			</model>
		</move>


		<clusterMines consumedMovement="0"
				cooldown="5"
				icon="Weapons/ClusterMines"
				requiredUpgrade="SpaceMarines/ClusterMines">
			<model>
				<action sound="Actions/MechanicalBuff"/>
			</model>
			<beginTargets>
				<target rangeMax="1">
					<conditions>
						<tile>
							<land/>
							<noEnemyUnit/>
						</tile>
					</conditions>
					<areas>
						<area affects="Tile">
							<modifiers>
								<modifier>
									<effects>
										<addFeature name="ClusterMines"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</target>
			</beginTargets>
		</clusterMines>
		<clearTileUnitAbility cooldown="1"
				icon="Actions/ClearTile"
				name="ClearTile">
			<model>
				<action/>
			</model>
			<beginTargets>
				<target rangeMax="1">
					<conditions/>
					<areas/>
				</target>
			</beginTargets>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="5"/>
						<requisitionsCost base="5"/>
					</effects>
				</modifier>
			</modifiers>			
		</clearTileUnitAbility>		
		<blessingsOfTheOmnissiah cooldown="1">
			<model>
				<action sound="Actions/Heal"/>
			</model>
			<beginTargets>
				<target rangeMax="1">
					<conditions>
						<unit>
							<allied/>
							<damaged/>
						</unit>
						<unit match="Any">
							<trait name="Fortification"/>
							<trait name="Vehicle"/>
						</unit>
					</conditions>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<hitpoints add="10"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</target>
			</beginTargets>
		</blessingsOfTheOmnissiah>
		<bolsterDefences cooldown="5">
			<model>
				<action sound="Actions/ArmourUp"/>
			</model>
			<beginTargets>
				<target rangeMax="2">
					<areas>
						<area affects="Tile">
							<modifiers>
								<modifier>
									<effects>
										<addFeature duration="3" name="BolsterDefences"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</target>
			</beginTargets>
		</bolsterDefences>
		<orbitalDeployment>
			<model>
				<action sound="Actions/DropPod"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="60"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="SpaceMarines/OrbitalRelay1">
					<effects>
						<influenceCost mul="-0.25"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="SpaceMarines/OrbitalRelay2">
					<effects>
						<influenceCost mul="-0.25"/>
					</effects>
				</modifier>

			</modifiers>
		</orbitalDeployment>

	</actions>
	<traits>


		<trait name="SpaceMarines/InfantryDefensivUpgrade" requiredUpgrade="SpaceMarines/InfantryDefensivUpgrade"/>
		<trait name="SpaceMarines/InfantryOffensivUpgrade" requiredUpgrade="SpaceMarines/InfantryOffensivUpgrade"/>

		<trait name="SpaceMarines/InfantryDefensivUpgrade2" requiredUpgrade="SpaceMarines/AdvancedDefensivUpgrade"/>
		<trait name="SpaceMarines/InfantryOffensivUpgrade2" requiredUpgrade="SpaceMarines/AdvancedOffensivUpgrade"/>

		<trait name="SpaceMarines/Devastator"/>

		<trait name="AndTheyShallKnowNoFear"/>
		<trait name="Bulky"/>
		<trait name="ConvergentTargeting"/>

		<trait name="LastStand" requiredUpgrade="SpaceMarines/LastStand"/>
	</traits>
</unit>
