	<traits>

		<trait name="SpaceMarines/VehicleDefensivUpgrade" requiredUpgrade="SpaceMarines/VehicleDefensivUpgrade"/>
		<trait name="SpaceMarines/VehicleOffensivUpgrade" requiredUpgrade="SpaceMarines/VehicleOffensivUpgrade"/>

		<trait name="SpaceMarines/VehicleDefensivUpgrade2" requiredUpgrade="SpaceMarines/AdvancedDefensivUpgrade"/>
		<trait name="SpaceMarines/VehicleOffensivUpgrade2" requiredUpgrade="SpaceMarines/AdvancedOffensivUpgrade"/>


		<trait name="SpaceMarines/Tactical"/>

		<trait name="AndTheyShallKnowNoFear"/>
		<trait name="DozerBlade" requiredUpgrade="SpaceMarines/DozerBlade"/>

		<trait name="LastStand" requiredUpgrade="SpaceMarines/LastStand"/>
		<trait name="SavantInterlocution"/>
		<trait name="Tank"/>
		<trait name="Vehicle"/>
		<trait name="SpaceMarines/HunterTargetingSystem"/>
	

	</traits>
</unit>
