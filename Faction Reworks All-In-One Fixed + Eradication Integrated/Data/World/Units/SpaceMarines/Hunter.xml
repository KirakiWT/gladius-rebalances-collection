<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>		
		<unit mesh="Units/SpaceMarines/Hunter"
				material="Units/SpaceMarines/Hunter"
				idleAnimation="Units/SpaceMarines/HunterIdle"
				idleAnimationCount="2"
				scale="1.1 1.1 1.1"
				explosionsBone="Hull"
				uvAnimated="1"/>
	</model>
	<weapons>
		<weapon name="SkyspearMissileLauncher">
			<model>
				<missileWeapon muzzleBone=".Muzzle0"
						fireInterval="0.75"/>
			</model>
		</weapon>
		<weapon name="HunterKillerMissile" slotName="HunterKillerMissile"
				enabled="0">
			<model>
				<missileWeapon muzzleBone="Hull"
						fireInterval="5.0"/>
			</model>	
		</weapon>		
	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="8"/> <!-- %armor base armor=12/12/10 -->
				<hitpointsMax base="24.0"/> <!-- %hitpointsMax base armor=12/12/10 wounds=3 -->
				<moraleMax base="10"/> <!-- %moraleMax base leadership=8 -->
				<movementMax base="4"/>
				<productionCost base="42.0"/> <!-- %productionCost base tier=7 factor=1 -->
				<rangedAccuracy base="12"/> <!-- %rangedAccuracy base ballisticSkill=4 -->
				<requisitionsUpkeep base="3"/> <!-- %requisitionsUpkeep base tier=7 factor=1 -->
				<requisitionsCost base="60.0"/> <!-- %requisitionsCost base tier=7 factor=1 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseVehiclesScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action
						animation="Units/SpaceMarines/HunterAttack"
						beginFire="0.7"
						endFire="2.5"/>
			</model>				
		</attack>
		<die>
			<model>
				<action animation="Units/SpaceMarines/HunterDie"
						sound="Units/MediumVehicleDie"
						soundCount="3"
						soundDelay="0"/>
			</model>		
		</die>
		<move>
			<model>
				<action animation="Units/SpaceMarines/HunterMove"
						sound="Units/SpaceMarines/TankMove"
						soundCount="3"/>
			</model>		
		</move>
		<createSmokeScreen cooldown="10"
				icon="Traits/SmokeScreen"
				requiredUpgrade="SpaceMarines/SmokeLauncher">
			<model>
				<action sound="Actions/SmokeScreen"/>
			</model>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Tile">
							<modifiers>
								<modifier>
									<effects>
										<addFeature duration="3" name="SmokeScreen"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</createSmokeScreen>
		<useWeapon weaponSlotName="HunterKillerMissile"
				cooldown="10"
				requiredUpgrade="SpaceMarines/HunterKillerMissile">
			<model>
				<action beginFire="0.1" endFire="1.0"/>
			</model>
		</useWeapon>
		<orbitalDeployment>
			<model>
				<action sound="Actions/DropPod"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="50"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="SpaceMarines/OrbitalRelay1">
					<effects>
						<influenceCost mul="-0.25"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="SpaceMarines/OrbitalRelay2">
					<effects>
						<influenceCost mul="-0.25"/>
					</effects>
				</modifier>

			</modifiers>
		</orbitalDeployment>
