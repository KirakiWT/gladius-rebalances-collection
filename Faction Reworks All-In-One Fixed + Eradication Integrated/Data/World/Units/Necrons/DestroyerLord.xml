			<model>
				<action sound="Actions/JumpPack"/>
			</model>
			<modifiers>
				<modifier>
					<effects>
						<movement add="1"/>
						<movementMax add="1"/>
					</effects>
				</modifier>
			</modifiers>
			<beginTargets>
				<target>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<addTrait duration="1" name="Necrons/JetCharge"/>
									</effects>
								</modifier>
								<modifier requiredUpgrade="Necrons/HammerOfWrath">
									<effects>
										<addTrait duration="1" name="HammerOfWrath"/>
