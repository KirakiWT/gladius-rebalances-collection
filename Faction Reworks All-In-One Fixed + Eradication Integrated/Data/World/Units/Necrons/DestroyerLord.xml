							<modifiers>
								<modifier>
									<effects>
										<addTrait name="Necrons/DestructionProtocols"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</destructionProtocols>
