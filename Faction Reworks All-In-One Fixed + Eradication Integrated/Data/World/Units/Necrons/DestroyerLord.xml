	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action	chargeAnimation="Units/Necrons/DestroyerLordCharge"
						chargeBeginFire="0.25"
						chargeEndFire="1.1"
						meleeAnimation="Units/Necrons/DestroyerLordMelee"
						meleeBeginSwing="0.2"
						meleeEndSwing="0.9"/>
