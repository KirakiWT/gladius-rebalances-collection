		<necrodermisRepair 
				consumedActionPoints="1" consumedMovement="0"
				cooldown="5"
				name="Necrons/NecrodermisRepair"
				requiredActionPoints="1">
			<model>
				<action sound="Actions/Heal"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="30"/>
					</effects>
				</modifier>
	
				<modifier requiredUpgrade="Necrons/NecrodermisRepair2">
					<effects>
						<consumedActionPoints max="0"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/NecrodermisRepair4">
					<effects>
						<cooldown add="-2"/>
					</effects>
				</modifier>
			</modifiers>
			<conditions>
				<unit>
					<damaged/>
				</unit>
			</conditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
											<hitpointsFactorFromMax add="0.25"/>
									</effects>
								</modifier>
								<modifier requiredUpgrade="Necrons/NecrodermisRepair3">
									<effects>
										<hitpointsFactorFromMax add="0.15"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</necrodermisRepair>


