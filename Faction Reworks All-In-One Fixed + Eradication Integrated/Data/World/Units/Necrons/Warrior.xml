<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>
		<unit mesh="Units/Necrons/Warrior"
				material="Units/Necrons/Warrior"
				idleAnimation="Units/Necrons/WarriorIdle"
				idleAnimationCount="3"
				idleContinuously="1"
				normalWeight="0.1"
				scale="1.1 1.1 1.1"
				explosionsBone="BloodBone"
				walker="1"/>
	</model>
	<group size="5" rowSize="3" memberDeltaX="64" memberDeltaY="64"/>
	<weapons>
		<weapon name="GaussFlayer">
			<model>
				<beamWeapon mesh="Weapons/Necrons/GaussFlayer"
						material="Units/Necrons/Warrior"
						muzzleBone=".Muzzle"
						bone="Bone074(mirrored)"
						fireInterval="0.45"/>
			</model>
		</weapon>
	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="6"/> <!-- %armor base armor=4+ -->
				<energyCost base="30.0"/> <!-- %energyCost base tier=5 factor=1 -->
				<hitpointsMax base="3"/> <!-- %hitpointsMax base toughness=4 wounds=1 -->
				<meleeAccuracy base="8"/> <!-- %meleeAccuracy base weaponSkill=4 -->
				<meleeAttacks base="1"/>
				<strengthDamage base="1.5"/> <!-- %strengthDamage base strength=4 -->
				<!-- <meleeInitiative base="2"/> -->
				<moraleMax base="10"/> <!-- %moraleMax base leadership=10 -->
				<movementMax base="3"/>
				<energyUpkeep base="1.5"/> <!-- %oreUpkeep base tier=5 factor=1 -->
				<productionCost base="30.0"/> <!-- %productionCost base tier=5 factor=1 -->
				<rangedAccuracy base="8"/> <!-- %rangedAccuracy base ballisticSkill=4 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseInfantryScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action	animation="Units/Necrons/WarriorAttack"
						beginFire="1.1"
						endFire="2.65"/>
			</model>
		</attack>
		<die>
			<model>
				<action animation="Units/Necrons/WarriorDie"
						animationCount="2"
						sound="Units/MediumArmoredDie"
						soundCount="4"
						soundDelay="0.5"
						voiceSound="Units/Necrons/Die"
						voiceSoundCount="7"/>
			</model>		
		</die>
		<idle>
			<model>
				<action animationSpeed="1.0"/>
			</model>
		</idle>
		<move>
			<model>
				<action animation="Units/Necrons/WarriorMove"
						sound="Units/Necrons/InfantryMove"
						soundCount="4"/>
			</model>
		</move>



		<necrodermisRepair 
				consumedActionPoints="1" consumedMovement="0"
				cooldown="5"
				name="Necrons/NecrodermisRepair"
				requiredActionPoints="1">
			<model>
				<action sound="Actions/Heal"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="10"/>
					</effects>
				</modifier>
	
				<modifier requiredUpgrade="Necrons/NecrodermisRepair2">
					<effects>
						<consumedActionPoints max="0"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/NecrodermisRepair4">
					<effects>
						<cooldown add="-2"/>
					</effects>
				</modifier>
			</modifiers>
			<conditions>
				<unit>
					<damaged/>
				</unit>
			</conditions>
			<beginTargets>
				<selfTarget>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<hitpointsFactorFromMax add="0.25"/>
									</effects>
								</modifier>
								<modifier requiredUpgrade="Necrons/NecrodermisRepair3">
									<effects>
										<hitpointsFactorFromMax add="0.15"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</necrodermisRepair>




		<dimensionalCorridor cooldown="3"
				name="Necrons/DimensionalCorridor"
				requiredUpgrade="Necrons/DimensionalCorridor">
			<model>
				<action sound="Actions/Teleport"/>
			</model>
			<modifiers>
				<modifier visible="0">
					<effects>
						<influenceCost base="20"/>
					</effects>
				</modifier>
				<modifier requiredUpgrade="Necrons/DimensionalCorridor3">
					<effects>
						<consumedActionPoints max="0"/>
						<consumedMovement max="0"/>
					</effects>
				</modifier>
			</modifiers>
		</dimensionalCorridor>




	</actions>
	<traits>

		<trait name="Necrons/InfantryDefensivUpgrade" requiredUpgrade="Necrons/InfantryDefensivUpgrade"/>
		<trait name="Necrons/InfantryOffensivUpgrade" requiredUpgrade="Necrons/InfantryOffensivUpgrade"/>

		<trait name="Necrons/InfantryDefensivUpgrade2" requiredUpgrade="Necrons/AdvancedDefensivUpgrade"/>
		<trait name="Necrons/InfantryOffensivUpgrade2" requiredUpgrade="Necrons/AdvancedOffensivUpgrade"/>



		<trait name="Necrons/AttackCityBonus" requiredUpgrade="Necrons/AttackCityBonus"/>

		<trait name="Necrons/ReanimationProtocols"/>
	</traits>
</unit>
